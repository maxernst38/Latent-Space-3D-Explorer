# Raw image datasets are the user's own — never committed.
# Their processed output lives in bundles/, which IS committed (see README).
datasets/*
!datasets/.gitkeep

# Intermediate embeddings, superseded by bundles/
embeddings/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Node
node_modules/
web/dist/

# Scratch space for dataset downloads
.cache/
